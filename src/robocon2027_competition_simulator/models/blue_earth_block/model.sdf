<?xml version="1.0"?>
<sdf version="1.10">
  <model name="blue_earth_block">
    <static>false</static>

    <link name="box_link">

      <!-- Khối lượng 0.6 kg, tâm khối tại tâm hình hộp -->
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.01225</ixx>
          <iyy>0.01225</iyy>
          <izz>0.01225</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Hình hộp màu xanh -->
      <visual name="box_visual">
        <geometry>
          <box>
            <size>0.35 0.35 0.35</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- Vùng va chạm -->
      <collision name="box_collision">
        <geometry>
          <box>
            <size>0.35 0.35 0.35</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>
  </model>
</sdf>

Panels:
  - Class: rviz_common/Displays
  - Class: rviz_common/Selection
  - Class: rviz_common/Tool Properties
  - Class: rviz_common/Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: World Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: viz_world
    - Class: rviz_default_plugins/TF
      Name: Both TF Trees
      Enabled: true
      Frames:
        All Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot1 Model
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot1/robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/RobotModel
      Name: Robot2 Model
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot2/robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Map
      Name: Robot1 Map
      Enabled: true
      Topic:
        Value: /robot1/map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 0.55
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: Robot2 Map
      Enabled: true
      Topic:
        Value: /robot2/map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 0.45
      Color Scheme: costmap
    - Class: rviz_default_plugins/LaserScan
      Name: Robot1 Scan
      Enabled: true
      Topic:
        Value: /robot1/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.035
      Style: Points
      Color Transformer: FlatColor
      Color: 40; 220; 80
    - Class: rviz_default_plugins/LaserScan
      Name: Robot2 Scan
      Enabled: true
      Topic:
        Value: /robot2/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.035
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 120; 40
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: viz_world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.785
      Yaw: 0.785
      Target Frame: viz_world
